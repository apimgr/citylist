<!DOCTYPE html>
<html lang="{{.Lang}}" dir="{{.Dir}}" class="theme-{{.Theme}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="base-url" content="{{.BaseURL}}">
    <title>{{t .Lang "coordinates.title"}} - {{t .Lang "footer.brand"}}</title>
    <meta name="description" content="{{t .Lang "coordinates.description"}}">
    <meta name="theme-color" content="#6366f1">
    <link rel="manifest" href="{{.BaseURL}}/manifest.json">
    <link rel="stylesheet" href="{{asset (printf "%s/static/css/common.css" .BaseURL)}}">
    <link rel="stylesheet" href="{{asset (printf "%s/static/css/components.css" .BaseURL)}}">
  {{if .HasAccent}}<link rel="stylesheet" href="{{asset (printf "%s/static/css/accent.css" .BaseURL)}}">{{end}}
</head>
<body>
  <a class="skip-link" href="#main-content">{{t .Lang "common.skip_main"}}</a>
  <a class="skip-link" href="#navigation">{{t .Lang "common.skip_navigation"}}</a>
  {{.SiteBanners}}
  <input type="checkbox" id="nav-toggle" class="nav-checkbox" aria-label="{{t .Lang "nav.toggle"}}">
  <header class="header">
    <a href="{{.BaseURL}}/" class="nav-brand"><picture><source media="(max-width: 640px)" srcset="{{.LogoURL}}?size=50"><img src="{{.LogoURL}}?size=200" alt="{{.BrandTitle}}"></picture>{{.BrandTitle}}</a>
    <nav id="navigation" class="nav-links" aria-label="{{t .Lang "nav.main"}}">
      <a href="{{.BaseURL}}/" class="nav-link">{{t .Lang "common.home"}}</a>
      <a href="{{.BaseURL}}/search" class="nav-link">{{t .Lang "common.search"}}</a>
      <a href="{{.BaseURL}}/coordinates" class="nav-link active" aria-current="page">{{t .Lang "coordinates.title"}}</a>
    </nav>
    <label for="nav-toggle" class="nav-toggle" aria-hidden="true">☰</label>
    <div class="header-actions">
      <a class="nav-link" href="{{.BaseURL}}/server/preferences">{{t .Lang "common.preferences"}}</a>
      <form class="theme-toggle-form" action="{{.BaseURL}}/server/preferences" method="post">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <input type="hidden" name="redirect" value="{{.ReturnTo}}">
        <input type="hidden" name="theme" value="{{.NextTheme}}">
        <button class="btn btn-ghost" type="submit" aria-label="{{t .Lang "common.theme_toggle"}}">{{t .Lang "common.theme_toggle"}}</button>
      </form>
    </div>
  </header>
<main id="main-content" class="container container-lg">
        <!-- Location Section -->
        <section class="search-section">
                <div class="section-header">
                    <h1 class="section-title">{{t .Lang "coordinates.title"}}</h1>
                    <p class="section-description">{{t .Lang "coordinates.description"}}</p>
                </div>

                <form id="coordForm" class="search-form" action="{{.BaseURL}}/coordinates" method="get">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="lat" class="form-label">{{t .Lang "coordinates.latitude"}}</label>
                            <input
                                type="number"
                                id="lat"
                                name="lat"
                                class="form-input"
                                step="any"
                                placeholder="40.7128"
                                required
                                min="-90"
                                max="90"
                                value="{{.Latitude}}"
                            >
                            <p class="form-hint">{{t .Lang "coordinates.latitude_range"}}</p>
                        </div>
                        <div class="form-group">
                            <label for="lon" class="form-label">{{t .Lang "coordinates.longitude"}}</label>
                            <input
                                type="number"
                                id="lon"
                                name="lon"
                                class="form-input"
                                step="any"
                                placeholder="-74.0060"
                                required
                                min="-180"
                                max="180"
                                value="{{.Longitude}}"
                            >
                            <p class="form-hint">{{t .Lang "coordinates.longitude_range"}}</p>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="radius" class="form-label">{{t .Lang "coordinates.radius"}}</label>
                            <input
                                type="number"
                                id="radius"
                                name="radius"
                                class="form-input"
                                min="1"
                                max="20000"
                                value="{{.Radius}}"
                            >
                        </div>
                        <div class="form-group">
                            <label for="limit" class="form-label">{{t .Lang "coordinates.max_results"}}</label>
                            <input
                                type="number"
                                id="limit"
                                name="limit"
                                class="form-input"
                                value="{{.Limit}}"
                                min="1"
                                max="100"
                            >
                        </div>
                    </div>
                    <div class="btn-group">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <span class="btn-icon">📍</span>
                            {{t .Lang "coordinates.find_nearby"}}
                        </button>
                        <button type="button" class="btn btn-secondary btn-lg" id="useLocation">
                            <span class="btn-icon">🎯</span>
                            {{t .Lang "coordinates.use_location"}}
                        </button>
                    </div>
                </form>

                {{if .SearchError}}<p class="form-error" role="alert">{{.SearchError}}</p>{{end}}

                <div id="locationStatus" class="location-status is-hidden" role="status" aria-live="polite">
                    <div class="location-status-icon">📍</div>
                    <span class="location-status-text">{{t .Lang "coordinates.getting_location"}}</span>
                </div>

                <div id="loading" class="loading-state is-hidden" role="status" aria-live="polite">
                    <div class="loading-spinner"></div>
                    <p>{{t .Lang "coordinates.finding_cities"}}</p>
                </div>

                <section id="results" class="results-section{{if not .HasCoordinates}} is-hidden{{end}}" aria-live="polite">
                    <div class="results-header">
                        <h2 class="results-title">{{t .Lang "coordinates.nearby_cities"}}</h2>
                        <span id="resultCount" class="results-count">{{if .HasCoordinates}}{{tp .Lang "plurals.cities_found" (len .Nearby)}}{{end}}</span>
                    </div>
                    <div id="resultsList" class="results-grid">
                        {{range .Nearby}}
                        <article class="result-card">
                            <div class="result-card-header">
                                <h3 class="result-card-title">{{.City.Name}}</h3>
                                <span class="result-card-badge">{{.City.Country}}</span>
                            </div>
                            <div class="result-card-body">
                                <div class="result-card-stat result-card-stat-highlight"><span class="result-card-stat-label">{{t $.Lang "results.distance"}}</span><span class="result-card-stat-value">{{printf "%.2f" .Distance}} km</span></div>
                                <div class="result-card-stat"><span class="result-card-stat-label">{{t $.Lang "results.latitude"}}</span><span class="result-card-stat-value">{{printf "%.4f" .City.Coord.Lat}}</span></div>
                                <div class="result-card-stat"><span class="result-card-stat-label">{{t $.Lang "results.longitude"}}</span><span class="result-card-stat-value">{{printf "%.4f" .City.Coord.Lon}}</span></div>
                            </div>
                        </article>
                        {{end}}
                    </div>
                </section>

                <div id="emptyState" class="empty-state{{if or (not .HasCoordinates) .Nearby}} is-hidden{{end}}">
                    <div class="empty-state-icon">📍</div>
                    <h3 class="empty-state-title">{{t .Lang "coordinates.no_results"}}</h3>
                    <p class="empty-state-description">{{t .Lang "coordinates.no_results_hint"}}</p>
                </div>
        </section>

        <!-- Quick Tips -->
        <section class="features">
                <div class="section-header">
                        <h2 class="section-title">{{t .Lang "coordinates.quick_tips"}}</h2>
                        <p class="section-description">{{t .Lang "coordinates.tips_description"}}</p>
                </div>
                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon">🎯</div>
                        <h3 class="feature-title">{{t .Lang "coordinates.use_location_title"}}</h3>
                        <p class="feature-description">{{t .Lang "coordinates.use_location_description"}}</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">📐</div>
                        <h3 class="feature-title">{{t .Lang "coordinates.adjust_radius"}}</h3>
                        <p class="feature-description">{{t .Lang "coordinates.adjust_radius_description"}}</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">🗺️</div>
                        <h3 class="feature-title">{{t .Lang "coordinates.world_coverage"}}</h3>
                        <p class="feature-description">{{t .Lang "coordinates.world_coverage_description"}}</p>
                    </div>
                </div>
        </section>
    </main>
  <nav class="nav-panel" id="nav-panel" aria-label="{{t .Lang "nav.main"}}">
    <label for="nav-toggle" class="nav-close" role="button" tabindex="0" aria-label="{{t .Lang "nav.close"}}">✕</label>
      <a href="{{.BaseURL}}/" class="nav-link">{{t .Lang "common.home"}}</a>
      <a href="{{.BaseURL}}/search" class="nav-link">{{t .Lang "common.search"}}</a>
      <a href="{{.BaseURL}}/coordinates" class="nav-link active" aria-current="page">{{t .Lang "coordinates.title"}}</a>
  </nav>
  <label for="nav-toggle" class="nav-overlay" aria-hidden="true"></label>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-content">
            <div class="footer-brand">
                <div class="footer-logo">🌍</div>
                <span class="footer-text">{{t .Lang "footer.brand"}}</span>
            </div>
            <div class="footer-links">
                <a href="{{.BaseURL}}/server/about" class="footer-link">{{t .Lang "nav.about"}}</a>
                <a href="{{.BaseURL}}/server/help" class="footer-link">{{t .Lang "nav.help"}}</a>
                <a href="{{.BaseURL}}/server/docs/swagger" class="footer-link">{{t .Lang "common.api_docs"}}</a>
                <a href="{{.BaseURL}}/server/privacy" class="footer-link">{{t .Lang "nav.privacy"}}</a>
                <a href="{{.BaseURL}}/server/terms" class="footer-link">{{t .Lang "nav.terms"}}</a>
                <a href="{{.BaseURL}}/server/preferences" class="footer-link">{{t .Lang "common.preferences"}}</a>
                <a href="{{.BaseURL}}/server/preferences#language" class="footer-link" lang="{{.Lang}}">{{.LanguageName}}</a>
                <a href="https://github.com/apimgr/citylist" class="footer-link">{{t .Lang "footer.github"}}</a>
            </div>
        </div>
    </footer>
    <script src="{{asset (printf "%s/static/js/app.js" .BaseURL)}}" defer></script>
    {{.ConsentBanner}}
</body>
</html>
{{define "theme-form"}}<form class="theme-toggle-form" action="{{.BaseURL}}/server/preferences" method="post"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><input type="hidden" name="redirect" value="{{.ReturnTo}}"><input type="hidden" name="theme" value="{{.NextTheme}}"><button class="btn btn-ghost" type="submit" aria-label="{{t .Lang "common.theme"}}">{{t .Lang "common.theme_toggle"}}</button></form>{{end}}
